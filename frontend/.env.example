# The only setting the web app reads. It is public: it is compiled into the browser code.
#
# Where the ClinicIT Spring Boot API runs. The WebSocket URL is derived from it (http→ws, https→wss, + /ws).
# Development falls back to http://localhost:8080 when it is unset. A production build without it has no API
# (the sign-in page says so), and a Vercel production build refuses a plain http:// URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
