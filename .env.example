# ClinicIT API configuration. Copy to your secret store / deployment environment; never commit
# real values. Local development needs none of this (see README). docs/OPERATIONS.md explains
# each setting. Values below are placeholders.

# --- Required with SPRING_PROFILES_ACTIVE=prod (startup fails clearly if missing or unsafe) ---
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://db.internal:5432/clinicit
DB_USERNAME=clinicit_app
DB_PASSWORD=<from-your-secret-store>
# Exact https origin(s) of the frontend, comma-separated. No wildcards.
CLINICIT_CORS_ALLOWED_ORIGINS=https://app.example.com
# Public URL of the frontend; patients' status links are {this}/status/{code}. https only.
CLINICIT_PUBLIC_APP_URL=https://app.example.com
# A real provider's name once one is added. No real provider ships yet, so production runs with
# notifications off; the development provider is refused in production.
CLINICIT_NOTIFICATIONS_PROVIDER=none
CLINICIT_NOTIFICATIONS_ENABLED=false

# --- Optional ---
# CLINICIT_NOTIFICATIONS_CHANNEL=SMS
# Wait-time ML service (ml/). Empty: estimates use the deterministic baseline.
# CLINICIT_ML_BASE_URL=http://ml.internal:8000
# CLINICIT_ML_TIMEOUT=PT0.8S
# DB_POOL_SIZE=10
# PORT=8080
# Internal port for health probes and Prometheus metrics. Do not expose it publicly.
# MANAGEMENT_PORT=8081
# CLINICIT_SESSION_TTL=PT12H

# --- First start on an empty database only: creates the first clinic and admin ---
# CLINICIT_BOOTSTRAP_CLINIC_NAME=City Clinic
# CLINICIT_BOOTSTRAP_CLINIC_TIMEZONE=Asia/Kolkata
# CLINICIT_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# CLINICIT_BOOTSTRAP_ADMIN_PASSWORD=<at-least-12-characters, from-your-secret-store>
