     "features": {"patientsAhead": 4, "recentConsultationMinutes": null, "historicalConsultationMinutes": null},
     "expected": {"minutes": 40.0, "estimate": 40, "lower": 20, "upper": 65}},
    {"name": "next in line",
     "features": {"patientsAhead": 0, "recentConsultationMinutes": 11.0, "historicalConsultationMinutes": 9.0},
     "expected": {"minutes": 0.0, "estimate": 0, "lower": 0, "upper": 5}},
    {"name": "fractional minutes",
     "features": {"patientsAhead": 1, "recentConsultationMinutes": 7.3, "historicalConsultationMinutes": null},
     "expected": {"minutes": 7.3, "estimate": 7, "lower": 3, "upper": 16}},
    {"name": "halves round up (not to even)",
     "features": {"patientsAhead": 1, "recentConsultationMinutes": 12.5, "historicalConsultationMinutes": null},
     "expected": {"minutes": 12.5, "estimate": 13, "lower": 6, "upper": 24}}
