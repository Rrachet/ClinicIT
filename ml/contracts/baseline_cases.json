  "description": "Shared test vectors for the deterministic baseline. Checked by BaselineWaitTimeTest (Java) and tests/test_baseline.py (Python) so both implementations stay identical.",
  "cases": [
    {"name": "today's recent consultations win",
     "features": {"patientsAhead": 3, "recentConsultationMinutes": 12.0, "historicalConsultationMinutes": 9.0},
